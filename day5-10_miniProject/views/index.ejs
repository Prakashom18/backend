<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <script src="https://unpkg.com/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="/stylesheets/styles.css" />
  </head>
  <body class="bg-zinc-900">
    <h1 class="text-blue-300">Fill Please</h1>
    <div class="main w-full min-h-screen bg-zinc-900 text-white">
      <div class="form p-5">
        <form action="/create" method="post">
          <input
            class="block mt-2 w-full px-5 outline-none py-2 bg-zinc-500 rounded-md"
            type="text" name="title"
            placeholder="title goes here"
          />
          <textarea
            class="block px-5 py-2 rounded-md w-full outline-none resize-none bg-zinc-500 mt-2"
            name="details"
            placeholder="Description here....."
          ></textarea>

          <input
            class="mt-2 bg-blue-500 rounded-lg outline-none p-2"
            type="submit"
            value="Create task"
          />
        </form>
      </div>
      <div class="tasks flex gap-3 flex-wrap p-10">
        <% if(files.length>0){ %>
           <% files.forEach(function(val){ %>
        <div class="task w-72 px-3 py-4 rounded-md bg-zinc-800">
          <h1 class="text-red text-3xl tracking-tighter">
         <%=val%>
          </h1>
          <a class="text-blue-500 inline-block mt-3" href="/files/<%=val%>">Read More</a>
          <a class="text-red-500 inline-block" href="/edit/<%=val%>"> Edit</a>
        </div>
        <% }) %> 
        <% } else{ %>
        <h3 class="text-green-300">No Tasks here</h3>
        <%} %>

        </div>
    </div>
  </body>
</html>
