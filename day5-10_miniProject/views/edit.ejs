<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://unpkg.com/@tailwindcss/browser@4"></script>
</head>
<body>

<div class="main w-full min-h-screen bg-zinc-900 text-white p-10">
  <a href="/" class="text-blue-300 ">Go Back to home</a>
  <div class="form p-5">
    <form action="/edit" method="post">
      <input
        class="block mt-2 w-full px-5 outline-none py-2 bg-zinc-500 rounded-md"
        type="text" name="previous"
        value="<%= filename%>"
        placeholder="Previous Name"
      />
      <input
        class="block mt-2 w-full px-5 outline-none py-2 bg-zinc-500 rounded-md"
        type="text" name="new"
        placeholder="new Name"
        value=""
      />

      <input
        class="mt-2 bg-yellow-500 rounded-lg outline-none p-2"
        type="submit"
        value="Update Name"
      />
    </form>
  </div>


</div>

    
</body>
</html>